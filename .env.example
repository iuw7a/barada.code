# Barada Code — environment configuration
# Copy to .env.local and fill in real values. Never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://barada:barada@localhost:5432/barada_code"

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session tokens (generate: openssl rand -base64 48)
AUTH_SECRET="change-me-generate-a-long-random-string"

# ── AI provider ─────────────────────────────────────────────────────────────
# API key for the AI provider (server-side only — never expose to the browser).
# Provider is selected in src/lib/ai/provider.ts (openai | anthropic).
AI_API_KEY=""
AI_MODEL="gpt-4o"

# ── Storage (Library assets) ────────────────────────────────────────────────
# Local filesystem storage root for uploaded assets (dev). Object-storage
# (S3/GCS) config goes here when that backend lands.
STORAGE_ROOT="./.storage"

# ── Integrations ────────────────────────────────────────────────────────────
# OAuth client credentials for the GitHub integration (connect flow).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Root domain for published projects ({subdomain}.{NEXT_PUBLIC_ROOT_DOMAIN}).
# Point wildcard DNS *.iuw7a.com at this server; on localhost use
# {subdomain}.localhost:3000 (browsers resolve *.localhost automatically).
NEXT_PUBLIC_ROOT_DOMAIN="iuw7a.com"

# Voice Agent (AssemblyAI) — https://assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -- Email (Nora Play / UseINBOX) -- server-side only, never commit the real key
NORA_PLAY_API_KEY=""
NORA_PLAY_API_URL="https://api.useinbox.email"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Execution engine (real sandbox) ─────────────────────────────────────────
# Sandbox backend: "local" (child processes under BARADA_SANDBOX_ROOT) for
# dev/single-node; add e2b/docker adapters by implementing SandboxProvider.
SANDBOX_PROVIDER="local"
# Root dir for project workspaces (real filesystems for builds/dev servers).
BARADA_SANDBOX_ROOT="./.sandboxes"
# Per-command limits.
SANDBOX_TIMEOUT_MS=120000
SANDBOX_MAX_OUTPUT=64000
# Agent loop cap (tool iterations per build turn).
AGENT_MAX_ITERATIONS=120

# ── Agent research tools (web / image / docs search) ───────────────────────
# Server-side only. Never expose these to the browser or commit real keys.
WEB_SEARCH_API_KEY=""
WEB_SEARCH_API_URL="https://google.serper.dev/search"
IMAGE_SEARCH_API_KEY=""
IMAGE_SEARCH_API_URL="https://google.serper.dev/images"

# ── Contact ─────────────────────────────────────────────────────────────────
# Where contact-form notifications are sent.
CONTACT_EMAIL="support@iuw7a.com"
